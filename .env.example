# Copy to .env and fill in. .env is gitignored.

# --- LLM (generation) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Embeddings ---
# Primary: Voyage AI voyage-3-large (1024-dim).
VOYAGE_API_KEY=...
# Fallback: OpenAI text-embedding-3-large (3072-dim).
# Only set if VOYAGE_API_KEY is empty AND you adjust schema.sql + config.yaml.
OPENAI_API_KEY=

# --- Reranker ---
# Cohere Rerank v3. Leave blank to use the self-hosted BGE fallback (Phase 3).
COHERE_API_KEY=...

# --- Database ---
# Matches docker-compose.yml. Override only if you run Postgres elsewhere.
DATABASE_URL=postgresql://gi:gi@localhost:5432/gi_guidelines
